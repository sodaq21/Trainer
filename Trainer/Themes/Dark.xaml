<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBg" Color="#0F0F12"/>
    <SolidColorBrush x:Key="CardBg" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#A0A0B0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#BB86FC"/>
    <!-- Мягкий фиолетовый -->
    <SolidColorBrush x:Key="ButtonHover" Color="#2D2D3F"/>

    <BitmapImage x:Key="SettingsIcon" UriSource="/Assets/settings_dark.png"/>
    <BitmapImage x:Key="CrosshairIcon" UriSource="/Assets/crosshair_dark.png"/>
    <BitmapImage x:Key="SwitchIcon" UriSource="/Assets/dark.png"/>
    <BitmapImage x:Key="PlayIcon" UriSource="/Assets/play_dark.png"/>
    <BitmapImage x:Key="StopIcon" UriSource="/Assets/stop_dark.png"/>
    <BitmapImage x:Key="TimerIcon" UriSource="/Assets/timer_dark.png"/>
    <BitmapImage x:Key="ReturnIcon" UriSource="/Assets/return_dark.png"/>
</ResourceDictionary>