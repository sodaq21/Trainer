<Window x:Class="Trainer.Windows.AimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trainer.Windows"
        mc:Ignorable="d"
        Title="Trainer - Aim" Height="480" Width="854" 
        PreviewKeyDown="Window_KeyDown" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <TextBlock Text="Aim Trainer" VerticalAlignment="Bottom" Style="{StaticResource TitleText}"/>
        </Grid>
        
        <Grid Grid.Row="0" Grid.Column="1">
            <Button x:Name="SettingsButton" Style="{StaticResource ServiceButton}" HorizontalAlignment="Right" Click="SettingsBtn_Click">
                <Image Source="{DynamicResource SettingsIcon}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="0">
            <Button Style="{StaticResource ServiceButton}" HorizontalAlignment="Left" Click="Exit_Click">
                <Image Source="{DynamicResource ReturnIcon}"/>
            </Button>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="2" Margin="10 5 10 15" IsEnabled="False" Background="#999999" Height="2" HorizontalAlignment="Stretch"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" >
            <Button Background="#57c470" Foreground="#FFFFFF" Style="{StaticResource AimButton}" Width="125" Content="Start" FontSize="24" Click="Start">
                <Button.Tag>
                    <Image Source="/Assets/play_dark.png" Width="30" Height="30"/>
                </Button.Tag>
            </Button>
            <Button Background="#dc3545" Style="{StaticResource AimButton}" Margin="10 0" Content="Stop" Width="125" 
                    x:Name="StopButton" Click="StopButton_Click" FontSize="24" Foreground="#FFFFFF" Padding="0">
                <Button.Tag>
                    <Image Source="/Assets/stop_dark.png" Width="30" Height="30"/>
                </Button.Tag>
            </Button>
        </StackPanel>
        

        <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource CommonText}"
                 Text="{Binding Score, StringFormat=Score: {0}}"  Margin="20 5"/>
        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource CommonText}"
           Text="{Binding Seconds}" Margin="20 5"/>
        <Canvas Grid.Row="3" Grid.ColumnSpan="2" Margin="20" x:Name="PlayArea" Background="{DynamicResource WindowBg}"/>
    </Grid>
</Window>
