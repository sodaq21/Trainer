<Window x:Class="Trainer.Windows.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trainer.Windows"
        mc:Ignorable="d"
            Title="Trainer - Menu" Height="360" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#dddddd">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button HorizontalAlignment="Right" Style="{StaticResource ServiceBtn}">
                <Image Source="/Assets/dark.png"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Button Style="{StaticResource MenuBtn}" Content="Aim Trainer" Click="AimBtn_Click"/>
                <Button Style="{StaticResource MenuBtn}" Content="Reaction Test" Margin="0" Click="ReactionBtn_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
