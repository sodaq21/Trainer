<Window x:Class="Trainer.Windows.ReactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trainer.Windows"
        mc:Ignorable="d"
        Title="Trainer - Reaction Time" Height="500" Width="700" PreviewKeyDown="Window_KeyUp" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Button Style="{StaticResource ServiceBtn}" HorizontalAlignment="Left" Click="Exit">
                    <Image Source="/Assets/return_light.png"/>
            </Button>
            <TextBlock Text="Reaction Time Test" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
        </Grid>

        <GridSplitter Grid.Row="1" Margin="5 0" IsEnabled="False"/>

        <Grid Grid.Row="2">
            <TextBlock x:Name="bestTxt" Style="{StaticResource CommonText}" Margin="15 0" HorizontalAlignment="Left" Text="{Binding BestTime, StringFormat='Best: {0} ms.', TargetNullValue='Best: -', FallbackValue='Best: -'}"/>
        </Grid>

        <Grid Grid.Row="3">
            <Button x:Name="react_btn" Click="ReactionClick">
                <Border x:Name="border" CornerRadius="20" Background="LightGray" Width="600" Height="350">
                    <TextBlock x:Name="txt" Text="Click when the button turns green" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>
        </Grid>
    </Grid>
</Window>
