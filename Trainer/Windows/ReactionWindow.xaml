<Window x:Class="Trainer.Windows.ReactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trainer - Reaction Time" Height="500" Width="700" PreviewKeyDown="Window_KeyUp" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button Style="{StaticResource ServiceBtn}" HorizontalAlignment="Left" Click="Exit" Content="←" FontSize="18"/>
            <TextBlock Text="Reaction Time" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>
        </Grid>

        <GridSplitter Grid.Row="1" IsEnabled="False"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="bestTxt" Style="{StaticResource CommonText}" HorizontalAlignment="Left"
                       Text="{Binding BestTime, StringFormat='Best: {0} ms', TargetNullValue='Best: -', FallbackValue='Best: -'}"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SurfacePanel}" Padding="14">
            <Button x:Name="react_btn" Click="ReactionClick" Background="{DynamicResource Brush.SurfaceMuted}" Foreground="{DynamicResource Brush.Text}">
                <Border x:Name="border" CornerRadius="14" Background="{DynamicResource Brush.SurfaceMuted}" Width="600" Height="350">
                    <TextBlock x:Name="txt" Text="Click when the panel turns green" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>
        </Border>
    </Grid>
</Window>
